{
  "name": "digicatalog",
  "version": "1.0.0",
  "private": true,
  "description": "Kiralanabilir dijital katalog SaaS - ürün katalogları oluşturun, müşterilerinizle paylaşın, PDF olarak sunun",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspaces",
    "server:dev": "npm run dev --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "start": "npm run start --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "test": "npm run test --workspaces",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-kit": "^0.31.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
