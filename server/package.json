{
  "name": "digicatalog-backend",
  "version": "1.0.0",
  "description": "DijiCatalog Backend - Express + TypeScript + mssql + Zod",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:ts": "tsc",
    "build:copy": "node scripts/copy-to-dist.js",
    "build": "npm run build:ts && npm run build:copy",
    "start": "node dist/index.js",
    "db:migrate-mssql": "node dist/scripts/apply-migration.js",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:seed-templates": "tsx scripts/seed-pdf-templates.ts",
    "smoke:templates": "node scripts/smoke-pdf-templates.mjs",
    "smoke:render": "node scripts/smoke-pdf-render.mjs",
    "smoke:shares": "node scripts/smoke-shares.mjs",
    "smoke:share-email": "tsx --env-file=.env.test scripts/smoke-share-email.ts",
    "deploy:helper": "node dist/scripts/deploy-helper.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^4.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
