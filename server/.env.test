# Smoke test env (Faz 10.1).
# Bu dosya sadece test/smoke script'lerinde kullanilir.
# Diger env'ler calisma dizinindeki .env'den gelir (.env bu dosyayi override etmez
# cunku dotenv.config() default override=false kullanir, mevcut env vars degismez).
#
# Amac: DATABASE_URL icin gecerli bir MSSQL format sagla ki env.ts validation'i
# smoke test sirasinda smoke'un kendi konfigurasyonuyla catismasin.

DATABASE_URL=mssql://sa:test@localhost:1433/DijiCatalog_smoke?encrypt=false&trustServerCertificate=true
JWT_SECRET=smoke-test-jwt-secret-min-32-chars-padded-for-validation
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_FROM=Smoke Test <smoke@digicatalog.local>
NODE_ENV=test
LOG_LEVEL=warn