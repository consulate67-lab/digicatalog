# Server Environment
# Copy to .env and fill in real values for local dev

# === Server core ===
NODE_ENV=development
PORT=3000

# === Database (PostgreSQL) ===
# Local dev: postgresql://user:pass@localhost:5432/digicatalog
# Railway: set automatically from PostgreSQL plugin
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digicatalog

# === Security (Faz 1'de zorunlu olacak) ===
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production-min-32-chars

# === CORS ===
# Comma-separated list of allowed origins. Use * only in dev.
# Production: https://app.digicatalog.com
ALLOWED_ORIGINS=http://localhost:5173

# === Logging ===
LOG_LEVEL=info
