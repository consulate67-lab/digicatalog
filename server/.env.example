# Server Environment
# Copy to .env and fill in real values for local dev

# === Server core ===
NODE_ENV=development
PORT=3000

# === Database (MSSQL) ===
# Format: mssql://user:password@server[:port]/database?encrypt=true|false&trustServerCertificate=true|false
# Notlar:
#   - Named instance icin: mssql://user:pass@server\INSTANCE/database?...
#     (port eklemeyin, SQL Browser dynamic port'u cozumler)
#   - Korgun ERP ile ayni instance uzerinde ayri DB
#   - LAN baglantisi icin encrypt=false & trustServerCertificate=true
# Ornekler:
#   LAN + named instance: mssql://sa:Passw0rd@192.168.2.67\ABKA/DijiCatalog?encrypt=false&trustServerCertificate=true
#   LAN + port:           mssql://sa:Passw0rd@192.168.2.67:49746/DijiCatalog?encrypt=false&trustServerCertificate=true
#   Cloud (Azure/Sql Server): mssql://user:pass@server.database.windows.net:1433/DijiCatalog?encrypt=true&trustServerCertificate=false
DATABASE_URL=mssql://sa:Password123@localhost:1433/DijiCatalog?encrypt=false&trustServerCertificate=true

# === Security (Faz 1'de zorunlu) ===
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === CORS ===
# Comma-separated list of allowed origins. Use * only in dev.
# Production: https://app.digicatalog.com
ALLOWED_ORIGINS=http://localhost:5173

# === Logging ===
LOG_LEVEL=info

# === ERP image URL prefix (Korgun ERP IIS server) ===
# ERP 'Picture' kolonu tam UNC/Windows path doner (orn:
#   "\\abkadc\DATA\RESİM\62\62 753 327 0933..jpg")
# Sync:
#   1) Path basindan ERP_IMAGE_PATH_PREFIX'i keser (UNC dahil)
#   2) Kalan relative path'i ERP_IMAGE_URL_PREFIX'in sonuna ekler
# Ornek: yukaridaki ornekten "/62/62 753 327 0933..jpg" kalir
#   -> http://192.168.2.67:1983/62/62 753 327 0933..jpg
#
# Default (Korgun makinesi):
#   URL:    http://192.168.2.67:1983/  (IIS 'resim' sitesi)
#   PATH:   \\abkadc\DATA\RESİM\      (IIS document root, UNC)
# Override: farkli makine/port veya farkli ERP kurulumu icin.
ERP_IMAGE_URL_PREFIX=http://192.168.2.67:1983/
ERP_IMAGE_PATH_PREFIX=\\abkadc\DATA\RESİM\